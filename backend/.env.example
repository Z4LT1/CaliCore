# Copia este archivo como ".env" (sin el .example) y ajusta los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore): contiene secretos.

# Clave secreta de Django. Firma sesiones y tokens internos. En producción debe ser larga y aleatoria.
# Para generar una:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-only-cambia-esto-en-produccion

# True solo en tu computador. En producción SIEMPRE False (DEBUG=True filtra información interna).
DEBUG=True

# Dominios desde los que Django acepta peticiones (separados por coma).
ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes del frontend autorizados a llamar a la API (CORS). 5500 es el puerto de la extensión Live Server.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- PostgreSQL (opcional, fase 2). Si DB_NAME no está definido, se usa SQLite. ---
# DB_NAME=calicore
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
